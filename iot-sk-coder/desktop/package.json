{
  "name": "nova-iot-stkitts",
  "version": "1.0.0",
  "description": "NOVA — IOT St. Kitts internal AI coding assistant",
  "author": "IOT St. Kitts Engineering <engineering@iotstkitts.com>",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack":  "electron-builder --dir",
    "dist":  "electron-builder --win"
  },
  "devDependencies": {
    "electron":         "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId":       "com.iotstkitts.nova",
    "productName": "NOVA",
    "copyright":   "© 2025 IOT St. Kitts Engineering",

    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!bridge/**/*",
      "!node_modules/**/*",
      "!dist/**/*"
    ],

    "extraResources": [
      { "from": "bridge",             "to": "bridge"      },
      { "from": "../istkc",           "to": "istkc"       },
      { "from": "../../open-design",  "to": "open-design" }
    ],

    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "signingHashAlgorithms": null,
      "sign": null,
      "signAndEditExecutable": false
    },

    "nsis": {
      "oneClick":                false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut":  true,
      "createStartMenuShortcut": true,
      "shortcutName":           "NOVA",
      "installerIcon":          "build/icon.ico",
      "uninstallerIcon":        "build/icon.ico",
      "installerHeaderIcon":    "build/icon.ico",
      "license":                "build/LICENSE.txt",
      "include":                "build/installer.nsh"
    },

    "mac": {
      "target": [
        { "target": "dmg",  "arch": ["x64", "arm64"] },
        { "target": "zip",  "arch": ["x64", "arm64"] }
      ],
      "icon":     "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null
    },

    "dmg": {
      "title":          "NOVA — IOT St. Kitts",
      "icon":           "build/icon.png",
      "background":     null,
      "window":         { "width": 540, "height": 380 },
      "contents": [
        { "x": 150, "y": 185, "type": "file" },
        { "x": 390, "y": 185, "type": "link", "path": "/Applications" }
      ]
    },

    "directories": {
      "output":     "dist",
      "buildResources": "build"
    }
  }
}
